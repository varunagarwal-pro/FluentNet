<Window
    x:Class="FluentNet.Classic.DiffPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentNet — Review Changes"
    Width="920"
    Height="560"
    MinWidth="760"
    MinHeight="440"
    WindowStartupLocation="CenterOwner"
    Background="#0F172A"
    Foreground="#F1F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" Text="Review Proposed Changes" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" />
            <TextBlock Text="Inspect Current vs. Proposed values and exact Windows target paths before applying." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
        </StackPanel>

        <DataGrid x:Name="ChangesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#111827"
                  Foreground="#E2E8F0"
                  RowBackground="#111827"
                  AlternatingRowBackground="#162032"
                  BorderBrush="#1E293B"
                  BorderThickness="1"
                  HorizontalGridLinesBrush="#1E293B"
                  VerticalGridLinesBrush="Transparent"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="30">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="210" />
                <DataGridTextColumn Header="Current" Binding="{Binding OldValue}" Width="100" />
                <DataGridTextColumn Header="Proposed" Binding="{Binding NewValue}" Width="110" />
                <DataGridTextColumn Header="Default" Binding="{Binding WindowsDefaultValue}" Width="95" />
                <DataGridTextColumn Header="Reboot" Binding="{Binding RequiresReboot}" Width="65" />
                <DataGridTextColumn Header="Exact Path / Command" Binding="{Binding ExactPath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
            <Button Content="Apply Changes (UAC)" Padding="16,7" Click="Apply_Click" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#38BDF8" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
