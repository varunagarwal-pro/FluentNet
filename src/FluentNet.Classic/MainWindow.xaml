<Window
    x:Class="FluentNet.Classic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentNet Classic — 64-Bit Network Stack Optimizer"
    Width="1160"
    Height="780"
    MinWidth="960"
    MinHeight="660"
    WindowStartupLocation="CenterScreen"
    Background="#0F172A"
    Foreground="#F1F5F9">
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0C4A6E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="RowBackground" Value="#111827" />
            <Setter Property="AlternatingRowBackground" Value="#162032" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1E293B" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="30" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar with Colorful Icons, Updates & Developer Credits -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <Border DockPanel.Dock="Bottom" Background="#162032" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Varun Agarwal • Sentinel Labs" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock x:Name="ClassicVersionText" Text="v0.1.5 • MIT Open Source" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,8" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SecondaryBtn}" Content="Updates" Padding="8,5" FontSize="11" Margin="0,0,4,0" Click="CheckUpdates_Click" />
                            <Button Style="{StaticResource SecondaryBtn}" Content="GitHub" Padding="8,5" FontSize="11" Margin="4,0,0,0" Click="OpenGitHub_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                        <Image Source="pack://application:,,,/Assets/fluentnet-icon.png" Width="28" Height="28" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="FluentNet" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Classic Portable • x64" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="NETWORK TUNING" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,0,0,6" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="dashboard" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/dashboard.png" Width="22" Height="22" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Host scan &amp; adapters" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="general" Click="Nav_Click" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/general.png" Width="22" Height="22" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="General Settings" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Speed, TCP &amp; offloads" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="advanced" Click="Nav_Click" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/advanced.png" Width="22" Height="22" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Advanced Settings" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Nagle, RTO, QoS &amp; ports" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="TOOLS &amp; SAFETY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,16,0,6" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="diagnostics" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/diagnostics.png" Width="22" Height="22" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="BDP &amp; Diagnostics" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="RWIN, MTU, ping &amp; trace" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="snapshots" Click="Nav_Click" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/snapshots.png" Width="22" Height="22" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Snapshots" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Backups &amp; rollback" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#162032" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
                <TextBlock x:Name="StatusText" Text="Scanning host..." FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- 1. OVERVIEW -->
            <Grid x:Name="DashboardPanel" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <Button Style="{StaticResource SecondaryBtn}" Content="Reset to Windows Defaults" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ResetDefaults_Click" />
                        <Button Style="{StaticResource SecondaryBtn}" Content="Re-Scan Host" DockPanel.Dock="Right" Click="Rescan_Click" />
                        <StackPanel>
                            <TextBlock x:Name="HostSummaryText" Text="Scanning..." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Select a profile below or tune settings directly in General &amp; Advanced." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="AdaptersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Adapter" Binding="{Binding Alias}" Width="180" />
                        <DataGridTextColumn Header="Type" Binding="{Binding MediaKind}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80" />
                        <DataGridTextColumn Header="Link Speed" Binding="{Binding SpeedText}" Width="110" />
                        <DataGridTextColumn Header="MTU" Binding="{Binding Ipv4Mtu}" Width="75" />
                        <DataGridTextColumn Header="IPv4 Address" Binding="{Binding Ipv4Display}" Width="140" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 2. GENERAL SETTINGS -->
            <ScrollViewer x:Name="GeneralPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,20,8">
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Connection Speed" FontWeight="SemiBold" />
                                <TextBlock x:Name="SpeedLabelText" Text="100 Mbps" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider x:Name="SpeedSlider" Minimum="1" Maximum="1000" Value="100" Margin="0,0,0,10" ValueChanged="SpeedSlider_ValueChanged" />
                            <WrapPanel>
                                <StackPanel Width="320" Margin="0,0,16,0">
                                    <TextBlock Text="Target Adapter" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AdapterCombo" SelectionChanged="AdapterCombo_Changed" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,16,0">
                                    <TextBlock Text="MTU" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <TextBox x:Name="MtuBox" Text="1500" Padding="6,4" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
                                </StackPanel>
                                <CheckBox x:Name="PppoeCheck" Content="PPPoE (1492)" Foreground="#E2E8F0" VerticalAlignment="Bottom" Margin="0,0,0,4" Checked="PppoeCheck_Changed" Unchecked="PppoeCheck_Changed" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2">
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbAutoTuning" DockPanel.Dock="Right" Width="140" Tag="tcp.autotuning" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Normal" /><ComboBoxItem Content="Disabled" /><ComboBoxItem Content="HighlyRestricted" /><ComboBoxItem Content="Restricted" /><ComboBoxItem Content="Experimental" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="TCP Auto-Tuning" FontWeight="SemiBold" /><TextBlock Text="Dynamic receive window scaling" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbHeuristics" DockPanel.Dock="Right" Width="120" Tag="tcp.heuristics" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Disabled" /><ComboBoxItem Content="Enabled" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="Scaling Heuristics" FontWeight="SemiBold" /><TextBlock Text="Disable to prevent auto-tuning cap" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbCongestion" DockPanel.Dock="Right" Width="120" Tag="tcp.congestion" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="CUBIC" /><ComboBoxItem Content="CTCP" /><ComboBoxItem Content="BBR2" /><ComboBoxItem Content="Default" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="Congestion Provider" FontWeight="SemiBold" /><TextBlock Text="CUBIC standard; BBR2 sets 24H2+ guard" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbEcn" DockPanel.Dock="Right" Width="120" Tag="tcp.ecn" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Default" /><ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Disabled" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="ECN Capability" FontWeight="SemiBold" /><TextBlock Text="RFC 3168 congestion signaling" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbRss" DockPanel.Dock="Right" Width="120" Tag="offload.rss" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Disabled" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="Receive-Side Scaling (RSS)" FontWeight="SemiBold" /><TextBlock Text="Multi-core packet processing" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbRsc" DockPanel.Dock="Right" Width="120" Tag="offload.rsc" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Disabled" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="Segment Coalescing (RSC)" FontWeight="SemiBold" /><TextBlock Text="Disable for low-jitter gaming" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbTimestamps" DockPanel.Dock="Right" Width="120" Tag="tcp.timestamps" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="Disabled" /><ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Default" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="TCP 1323 Timestamps" FontWeight="SemiBold" /><TextBlock Text="Saves 12 bytes per packet when off" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,8">
                            <DockPanel>
                                <ComboBox x:Name="CmbTtl" DockPanel.Dock="Right" Width="120" Tag="reg.default_ttl" SelectionChanged="InteractiveSetting_Changed">
                                    <ComboBoxItem Content="64" /><ComboBoxItem Content="128" /><ComboBoxItem Content="255" />
                                </ComboBox>
                                <StackPanel><TextBlock Text="Default TTL" FontWeight="SemiBold" /><TextBlock Text="Max IP hop limit (64 optimal)" FontSize="11" Foreground="#94A3B8" /></StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. ADVANCED SETTINGS -->
            <DataGrid x:Name="DiffGrid" Grid.Row="1" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="230" />
                    <DataGridTextColumn Header="Current" Binding="{Binding OldValue}" Width="110" />
                    <DataGridTextColumn Header="Proposed" Binding="{Binding NewValue}" Width="110" />
                    <DataGridTextColumn Header="Default" Binding="{Binding WindowsDefaultValue}" Width="100" />
                    <DataGridTextColumn Header="Reboot" Binding="{Binding RequiresReboot}" Width="70" />
                    <DataGridTextColumn Header="Exact Path" Binding="{Binding ExactPath}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 4. BDP & DIAGNOSTICS -->
            <Grid x:Name="DiagnosticsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mbps:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="BdpBwBox" Text="100" Width="80" Margin="0,0,12,0" Padding="6,4" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
                        <TextBlock Text="Latency (ms):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="BdpMsBox" Text="40" Width="70" Margin="0,0,12,0" Padding="6,4" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
                        <TextBlock Text="MTU:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="BdpMtuBox" Text="1500" Width="70" Margin="0,0,12,0" Padding="6,4" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
                        <Button Style="{StaticResource PrimaryBtn}" Content="Calculate BDP" Margin="0,0,12,0" Click="CalcBdp_Click" />
                        <TextBlock x:Name="BdpResultText" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#38BDF8" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="HostsBox" Text="1.1.1.1, 8.8.8.8, www.speedguide.net" Width="340" Margin="0,0,8,0" Padding="6,5" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" />
                    <Button Style="{StaticResource SecondaryBtn}" Content="Largest MTU" Margin="0,0,6,0" Click="RunMtu_Click" />
                    <Button Style="{StaticResource PrimaryBtn}" Content="Latency Sweep" Margin="0,0,6,0" Click="RunLatency_Click" />
                    <Button Style="{StaticResource SecondaryBtn}" Content="Trace" Margin="0,0,6,0" Click="RunTrace_Click" />
                    <Button x:Name="StopBtn" Style="{StaticResource SecondaryBtn}" Content="Stop" IsEnabled="False" Margin="0,0,6,0" Click="Stop_Click" />
                    <Button Style="{StaticResource SecondaryBtn}" Content="Clear" Click="Clear_Click" />
                </StackPanel>
                <TextBox x:Name="DiagBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Padding="10" Background="#111827" Foreground="#E2E8F0" BorderBrush="#1E293B" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!-- 5. SNAPSHOTS -->
            <Grid x:Name="SnapshotsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource SecondaryBtn}" Content="Refresh Backups" Margin="0,0,8,0" Click="RefreshSnaps_Click" />
                    <Button Style="{StaticResource PrimaryBtn}" Content="1-Click Rollback Selected (UAC)" Click="RollbackSnap_Click" />
                </StackPanel>
                <ListBox x:Name="SnapshotsList" Grid.Row="1" Background="#111827" Foreground="#E2E8F0" BorderBrush="#1E293B" />
            </Grid>

            <!-- PERSISTENT BOTTOM PROFILE & APPLY BAR -->
            <Border Grid.Row="2" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryBtn}" Content="Export .ps1 / .reg" Margin="0,0,8,0" Click="ExportScripts_Click" />
                        <Button Style="{StaticResource PrimaryBtn}" Content="Apply Changes..." Click="PreviewSelected_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profile:" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="RadDefault" Content="Windows Default" Foreground="#E2E8F0" GroupName="ProfileGroup" Margin="0,0,12,0" Checked="ProfileRadio_Checked" />
                        <RadioButton x:Name="RadCurrent" Content="Current" Foreground="#E2E8F0" GroupName="ProfileGroup" Margin="0,0,12,0" Checked="ProfileRadio_Checked" />
                        <RadioButton x:Name="RadOptimal" Content="Optimal" Foreground="#E2E8F0" GroupName="ProfileGroup" IsChecked="True" Margin="0,0,12,0" Checked="ProfileRadio_Checked" />
                        <RadioButton x:Name="RadGaming" Content="Gaming" Foreground="#E2E8F0" GroupName="ProfileGroup" Margin="0,0,12,0" Checked="ProfileRadio_Checked" />
                        <RadioButton x:Name="RadCustom" Content="Custom" Foreground="#E2E8F0" GroupName="ProfileGroup" Checked="ProfileRadio_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
