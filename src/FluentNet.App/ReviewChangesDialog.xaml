<ContentDialog
    x:Class="FluentNet.App.ReviewChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentNet.App"
    DefaultButton="Primary"
    PrimaryButtonText="Apply Changes"
    CloseButtonText="Cancel"
    CornerRadius="12">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" Width="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary & Snapshot Banner -->
        <Border Grid.Row="0" Style="{StaticResource HeroCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SummaryHeadline" Text="Review Proposed Changes" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummarySubtext"
                               Text="A timestamped JSON rollback snapshot is saved automatically before applying any setting natively via .NET."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border x:Name="RebootBadge" Grid.Column="1" CornerRadius="999" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="RebootBadgeText" FontSize="11.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Column Headers -->
        <Grid Grid.Row="1" Padding="12,4,26,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="95" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="SETTING &amp; NATIVE TARGET" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="CURRENT" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="PROPOSED" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource FluentAccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="DEFAULT" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
        </Grid>

        <!-- Scrollable Diff Rows with Right Scrollbar Clearance -->
        <ScrollViewer Grid.Row="2" MaxHeight="400" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="DiffRepeater" Margin="0,0,20,0">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:DiffReviewRow">
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="12,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="95" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind DisplayName}" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                        <Border Visibility="{x:Bind RebootVisibility}" Background="{ThemeResource FluentWarningSoftBrush}" CornerRadius="999" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="Reboot" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource FluentWarningBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource FluentPillBgBrush}" CornerRadius="999" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SourceLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ExactPath}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{ThemeResource FluentPillBgBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind OldValue}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <FontIcon Grid.Column="3" Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource FluentAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <Border Grid.Column="4" Background="{ThemeResource FluentAccentSoftBrush}" BorderBrush="{ThemeResource FluentAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind NewValue}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource FluentAccentBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <TextBlock Grid.Column="5" Text="{x:Bind DefaultValue}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</ContentDialog>
