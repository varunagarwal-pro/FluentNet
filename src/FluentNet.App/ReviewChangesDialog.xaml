<ContentDialog
    x:Class="FluentNet.App.ReviewChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentNet.App"
    DefaultButton="Primary"
    PrimaryButtonText="Apply Changes (UAC)"
    CloseButtonText="Cancel"
    CornerRadius="10">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">820</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" Width="780">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary & Snapshot Banner -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SummaryHeadline" Text="Review Proposed Changes" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="A timestamped JSON rollback snapshot is saved automatically before applying any setting."
                               FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
                <Border x:Name="RebootBadge" Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="RebootBadgeText" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Column Headers -->
        <Grid Grid.Row="1" Padding="12,4,26,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="SETTING &amp; TARGET PATH" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
            <TextBlock Grid.Column="2" Text="CURRENT" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="PROPOSED" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="DEFAULT" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right" />
        </Grid>

        <!-- Scrollable Diff Rows with Right Scrollbar Clearance -->
        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="DiffRepeater" Margin="0,0,18,0">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:DiffReviewRow">
                        <Border Background="#162032" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind DisplayName}" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                                        <Border Visibility="{x:Bind RebootVisibility}" Background="#3F2A14" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="Reboot" FontSize="9" FontWeight="SemiBold" Foreground="#FBBF24" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ExactPath}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind OldValue}" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <FontIcon Grid.Column="3" Glyph="&#xE72A;" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <Border Grid.Column="4" Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind NewValue}" FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#7DD3FC" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <TextBlock Grid.Column="5" Text="{x:Bind DefaultValue}" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</ContentDialog>
