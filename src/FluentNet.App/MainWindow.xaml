<Window
    x:Class="FluentNet.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentNet.App"
    Title="FluentNet">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="AccelFocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="FluentNet"
                  Subtitle="64-Bit Network Stack Optimizer"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="TitleSearchBox"
                                MinWidth="220"
                                MaxWidth="360"
                                Width="320"
                                VerticalAlignment="Center"
                                PlaceholderText="Search adapters or properties… (Ctrl+F)"
                                QueryIcon="Find"
                                TextChanged="TitleSearchBox_TextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        OpenPaneLength="248"
                        CompactPaneLength="54"
                        CompactModeThresholdWidth="640"
                        ExpandedModeThresholdWidth="900"
                        ItemInvoked="NavView_ItemInvoked"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="NETWORK TUNING" />
                <NavigationViewItem Tag="dashboard" IsSelected="True" ToolTipService.ToolTip="Host summary, live adapter status, and quick profile switching">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/icons/dashboard.png" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Host scan &amp; adapters" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem Tag="general" ToolTipService.ToolTip="Connection speed, adapter selection, TCP Auto-Tuning, Congestion &amp; Offloads">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/icons/general.png" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock Text="General Settings" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Speed, TCP &amp; offloads" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem Tag="advanced" ToolTipService.ToolTip="Nagle gaming tweaks, RTO timeouts, QoS, dynamic ports &amp; NIC properties">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/icons/advanced.png" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Advanced Settings" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Nagle, RTO, QoS &amp; ports" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="TOOLS &amp; SAFETY" />
                <NavigationViewItem Tag="diagnostics" ToolTipService.ToolTip="BDP/RWIN calculator, Largest Path MTU, Latency sweep &amp; Traceroute">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/icons/diagnostics.png" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock Text="BDP &amp; Diagnostics" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="RWIN, MTU, ping &amp; trace" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem Tag="snapshots" ToolTipService.ToolTip="Pre-change configuration backups &amp; 1-click rollback">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/icons/snapshots.png" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Snapshots &amp; Restore" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Backups &amp; 1-click rollback" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <NavigationViewItem x:Name="UpdateNavItem"
                                    Tag="check_updates"
                                    SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Check GitHub for FluentNet updates">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="UpdateNavIcon" Glyph="&#xE895;" Foreground="#38BDF8" />
                    </NavigationViewItem.Icon>
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="UpdateNavTitle" Text="Check for Updates" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="UpdateNavSub" Text="Varun Agarwal • GitHub" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.PaneFooter>

            <Grid Padding="24,16,20,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Dismissible Action Banner (only open during scan, error, or action confirmation) -->
                <InfoBar x:Name="StatusBanner"
                         Grid.Row="0"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <!-- 1. OVERVIEW (Fixed Header + Scrollable Content with 20px right clearance) -->
                <Grid x:Name="DashboardPanel" Grid.Row="1" Visibility="Visible" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Host Network Overview" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="OverviewSubtitleText"
                                       Text="Scanning host network stack..."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="ResetDefaults_Click" Content="Reset to Windows Defaults" />
                            <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="RescanButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="#38BDF8" />
                                    <TextBlock Text="Re-Scan" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="OverviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="0,0,20,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource DarkSlateCardStyle}" Padding="14,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#16304B" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="#38BDF8" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="OPERATING SYSTEM" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            <TextBlock x:Name="KpiOsText" Text="Scanning..." FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="KpiCpuText" Text="—" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource DarkSlateCardStyle}" Padding="14,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#0F3329" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="#10B981" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="ACTIVE CONNECTION" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                            <TextBlock x:Name="KpiNicText" Text="Scanning..." FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="KpiLinkText" Text="—" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DarkSlateCardStyle}" Padding="14,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#3B2710" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEC4A;" FontSize="15" Foreground="#F59E0B" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="CONGESTION ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            <TextBlock x:Name="KpiCongestionText" Text="—" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="KpiBbrGuardText" Text="—" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource DarkSlateCardStyle}" Padding="14,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#271F45" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="#A78BFA" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="PENDING CHANGES" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA" />
                                            <TextBlock x:Name="KpiDriftText" Text="—" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="KpiProfileLabel" Text="Profile: Optimal" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid>
                                <TextBlock Text="Network Adapters" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="AdaptersCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ItemsRepeater x:Name="AdaptersRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:AdapterDisplayRow">
                                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{x:Bind IconPath}" Width="34" Height="34" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Alias}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{x:Bind SpeedAndMtu}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind IpAddress}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <Border Grid.Column="3" CornerRadius="12" Padding="10,4" Background="{x:Bind StatusBg}" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusFg}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. GENERAL SETTINGS (Fixed Header + Scrollable Controls with 20px right clearance) -->
                <Grid x:Name="GeneralPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="General TCP/IP &amp; Adapter Offloads" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Configure connection speed, target adapter, TCP window scaling, congestion control, and hardware offloads."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DarkSecondaryButtonStyle}" Click="ResetDefaults_Click" Content="Reset to Windows Defaults" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer x:Name="GeneralScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,0,20,8">
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,14">
                                <Grid RowSpacing="12" ColumnSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Connection Speed" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SpeedLabelText" Text="100 Mbps" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        </Grid>
                                        <Slider x:Name="SpeedSlider" Minimum="1" Maximum="1000" Value="100" StepFrequency="10" ValueChanged="SpeedSlider_ValueChanged" />
                                    </StackPanel>

                                    <ComboBox x:Name="AdapterCombo" Grid.Row="1" Grid.Column="0" Header="Target Network Adapter" HorizontalAlignment="Stretch" SelectionChanged="AdapterCombo_Changed" />
                                    <TextBox x:Name="MtuBox" Grid.Row="1" Grid.Column="1" Header="MTU" Text="1500" Width="90" />
                                    <CheckBox x:Name="PppoeCheck" Grid.Row="1" Grid.Column="2" Content="PPPoE (1492)" VerticalAlignment="Bottom" Margin="0,0,0,4" Checked="PppoeCheck_Changed" Unchecked="PppoeCheck_Changed" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TCP Window Auto-Tuning" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Dynamically scales RWIN for throughput" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbAutoTuning" Grid.Column="1" Width="150" Tag="tcp.autotuning" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Scaling Heuristics" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Disable so Windows won't throttle auto-tuning" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbHeuristics" Grid.Column="1" Width="135" Tag="tcp.heuristics" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Congestion Control Provider" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="CUBIC standard; BBR2 sets 24H2+ loopback guard" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbCongestion" Grid.Column="1" Width="135" Tag="tcp.congestion" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="ECN Capability" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Explicit Congestion Notification (RFC 3168)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbEcn" Grid.Column="1" Width="135" Tag="tcp.ecn" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Receive-Side Scaling (RSS)" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Distributes packet processing across CPU cores" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbRss" Grid.Column="1" Width="135" Tag="offload.rss" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Receive Segment Coalescing (RSC)" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Disable in Gaming mode to lower jitter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbRsc" Grid.Column="1" Width="135" Tag="offload.rsc" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TCP 1323 Timestamps" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Disable to save 12 bytes header overhead" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbTimestamps" Grid.Column="1" Width="135" Tag="tcp.timestamps" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Time to Live (DefaultTTL)" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Max IP hop count (64 optimal, 128 default)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbTtl" Grid.Column="1" Width="135" Tag="reg.default_ttl" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. ADVANCED SETTINGS (Fixed Header + Scrollable Sections with 20px right clearance) -->
                <Grid x:Name="AdvancedPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Advanced TCP/IP, Gaming &amp; Registry Tuning" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Fine-grained controls grouped by subsystem. Most registry edits require a reboot to take full effect."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DarkSecondaryButtonStyle}" Click="ResetDefaults_Click" Content="Reset to Windows Defaults" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer x:Name="AdvancedScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,0,20,8">
                            <TextBlock Text="Gaming, Throttling &amp; Nagle's Algorithm (Selected Adapter)" FontSize="13" FontWeight="SemiBold" Foreground="#F97316" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="NetworkThrottlingIndex" FontWeight="SemiBold" /><TextBlock Text="Disable multimedia throttling (0xffffffff) for full throughput" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbThrottling" Grid.Column="1" Width="135" Tag="reg.network_throttling" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="SystemResponsiveness" FontWeight="SemiBold" /><TextBlock Text="CPU % reserved for background tasks (10 optimal)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbResponsiveness" Grid.Column="1" Width="135" Tag="reg.system_responsiveness" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TcpAckFrequency (Nagle)" FontWeight="SemiBold" /><TextBlock Text="1 = immediate ACKs for gaming; 2 = Windows default" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbAckFreq" Grid.Column="1" Width="135" Tag="nic.tcpackfreq" SelectionChanged="InteractiveNicCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TCPNoDelay (Nagle)" FontWeight="SemiBold" /><TextBlock Text="1 = disable packet coalescing for real-time apps" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbNoDelay" Grid.Column="1" Width="135" Tag="nic.tcpnodelay" SelectionChanged="InteractiveNicCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TcpDelAckTicks (Nagle)" FontWeight="SemiBold" /><TextBlock Text="0 = zero delayed ACK timer; 2 = 200ms default" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbDelAckTicks" Grid.Column="1" Width="135" Tag="nic.tcpdelackticks" SelectionChanged="InteractiveNicCombo_Changed" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="Retransmissions &amp; Timeouts (RTO)" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,0" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Max SYN Retransmissions" FontWeight="SemiBold" /><TextBlock Text="Retries before failing unreachable handshake (2 optimal)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbMaxSyn" Grid.Column="1" Width="135" Tag="tcp.maxsynretx" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="NonSack Rtt Resiliency" FontWeight="SemiBold" /><TextBlock Text="Keep Disabled for modern SACK networks" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbNonSack" Grid.Column="1" Width="135" Tag="tcp.nonsackrtt" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Initial RTO (ms)" FontWeight="SemiBold" /><TextBlock Text="Initial retransmission timeout (2000 optimal, 1000 gaming)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbInitialRto" Grid.Column="1" Width="135" Tag="tcp.initialrto" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="Min RTO (ms)" FontWeight="SemiBold" /><TextBlock Text="Minimum retransmission floor (300ms safe baseline)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbMinRto" Grid.Column="1" Width="135" Tag="tcp.minrto" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="Dynamic Ports &amp; QoS" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" Margin="0,4,0,0" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="MaxUserPort" FontWeight="SemiBold" /><TextBlock Text="Expands ephemeral port pool (65534 optimal)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbMaxUserPort" Grid.Column="1" Width="135" Tag="reg.max_user_port" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="TcpTimedWaitDelay (s)" FontWeight="SemiBold" /><TextBlock Text="TIME_WAIT socket reuse delay (30s optimal, 120s default)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbTimedWait" Grid.Column="1" Width="135" Tag="reg.tcp_timed_wait_delay" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="QoS NonBestEffortLimit (%)" FontWeight="SemiBold" /><TextBlock Text="Reservable bandwidth limit (0% removes QoS cap)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbQosLimit" Grid.Column="1" Width="135" Tag="reg.qos_non_best_effort" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock Text="QoS: Do not use NLA" FontWeight="SemiBold" /><TextBlock Text="Bypass Network Location Awareness check (1 optimal)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="CmbQosNla" Grid.Column="1" Width="135" Tag="reg.qos_do_not_use_nla" SelectionChanged="InteractiveCombo_Changed" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="DriverPropsHeader" Text="Selected Adapter Driver Properties" FontSize="13" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,4,0,0" />
                            <ItemsRepeater x:Name="DriverPropsRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="320" MaximumRowsOrColumns="2" MinColumnSpacing="12" MinRowSpacing="8" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriverPropRow">
                                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="12,8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind RegistryKeyword}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="5" Padding="8,3" Background="#1E293B" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayValue}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#38BDF8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. BDP & DIAGNOSTICS -->
                <Grid x:Name="DiagnosticsPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BdpBandwidthBox" Header="Bandwidth (Mbps)" Text="100" Width="130" />
                            <TextBox x:Name="BdpLatencyBox" Grid.Column="1" Header="Latency (ms)" Text="40" Width="110" />
                            <TextBox x:Name="BdpMtuBox" Grid.Column="2" Header="MTU" Text="1500" Width="90" />
                            <Button Grid.Column="3" Style="{StaticResource ElectricAccentButtonStyle}" VerticalAlignment="Bottom" Click="CalculateBdp_Click" Content="Calculate BDP" />
                            <Border Grid.Column="4" Style="{StaticResource SubtleCardStyle}" Padding="12,8" VerticalAlignment="Bottom">
                                <TextBlock x:Name="BdpResultText" Text="Enter bandwidth &amp; latency to compute MSS-aligned RWIN" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DiagHostsBox" Header="Target Hosts (comma-separated)" Text="1.1.1.1, 8.8.8.8, www.speedguide.net" Width="340" />
                            <Button Style="{StaticResource DarkSecondaryButtonStyle}" VerticalAlignment="Bottom" Click="RunMtu_Click" Content="Largest MTU" />
                            <Button Style="{StaticResource ElectricAccentButtonStyle}" VerticalAlignment="Bottom" Click="RunLatency_Click" Content="Latency Sweep" />
                            <Button Style="{StaticResource DarkSecondaryButtonStyle}" VerticalAlignment="Bottom" Click="RunTrace_Click" Content="Trace" />
                            <Button x:Name="StopDiagButton" Content="Stop" IsEnabled="False" VerticalAlignment="Bottom" Click="StopDiag_Click" />
                            <Button Content="Clear" VerticalAlignment="Bottom" Click="ClearDiag_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource DarkSlateCardStyle}" Padding="12">
                        <TextBox x:Name="DiagOutputBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E2E8F0"
                                 FontFamily="{StaticResource MonoFont}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <!-- 5. SNAPSHOTS & ROLLBACK -->
                <Grid x:Name="SnapshotsPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="RefreshSnapshots_Click" Content="Refresh Backups" />
                        <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="OpenSnapshotsFolder_Click" Content="Open Backups Folder" />
                        <Button Style="{StaticResource ElectricAccentButtonStyle}" Click="RollbackSelected_Click" Content="1-Click Rollback Selected (UAC)" />
                    </StackPanel>
                    <ListView x:Name="SnapshotsList" Grid.Row="1" SelectionMode="Single" />
                </Grid>

                <!-- 6. APP SETTINGS (Fixed Header + Scrollable Content with 20px right clearance) -->
                <Grid x:Name="AppSettingsPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Application Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                    <ScrollViewer x:Name="AppSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="0,0,20,8">
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Theme" FontWeight="SemiBold" />
                                        <TextBlock Text="Switch between System, Dark, and Light appearance" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="150" SelectionChanged="ThemeCombo_Changed" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Show Virtual, Tunnel &amp; Ghost Adapters" FontWeight="SemiBold" />
                                        <TextBlock Text="Include VPN, Bluetooth, and disconnected secondary adapters in Overview" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ToggleVirtualAdapters" Grid.Column="1" IsOn="False" OnContent="Shown" OffContent="Hidden" Toggled="VirtualAdapters_Toggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Snapshots &amp; Backup Directory" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SnapshotFolderText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource DarkSecondaryButtonStyle}" Content="Open Folder" Click="OpenSnapshotsFolder_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Software Updates" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock x:Name="UpdateStatusText" Text="Click Check Now to query GitHub Releases (with version.txt fallback)." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource ElectricAccentButtonStyle}" Content="Check Now" Click="CheckUpdatesButton_Click" VerticalAlignment="Center" />
                                        <Button x:Name="DownloadUpdateButton" Grid.Column="2" Style="{StaticResource DarkSecondaryButtonStyle}" Content="Releases" Click="DownloadOrOpenRelease_Click" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="UpdateNotesText" Visibility="Collapsed" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DarkSlateCardStyle}" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="Assets/fluentnet-icon.png" Width="38" Height="38" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Developed by Varun Agarwal • Sentinel Labs" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                                            <TextBlock x:Name="AboutVersionText" Text="FluentNet • 64-bit Windows Network Stack Optimizer • MIT Open Source • Zero Telemetry" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#0C4A6E" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="Open Source" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource ElectricAccentButtonStyle}" Click="OpenGitHubRepo_Click" Content="Open GitHub Repository" />
                                        <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="OpenDeveloperProfile_Click" Content="@varunagarwal-pro" />
                                        <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="OpenGitHubIssues_Click" Content="Report Issue" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PERSISTENT BOTTOM PROFILE & APPLY BAR -->
                <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="14,10" Margin="0,0,20,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Profile:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <RadioButton x:Name="RadDefault" Content="Windows Default" GroupName="ProfileGroup" Checked="ProfileRadio_Checked" />
                            <RadioButton x:Name="RadCurrent" Content="Current" GroupName="ProfileGroup" Checked="ProfileRadio_Checked" />
                            <RadioButton x:Name="RadOptimal" Content="Optimal" GroupName="ProfileGroup" IsChecked="True" Checked="ProfileRadio_Checked" />
                            <RadioButton x:Name="RadGaming" Content="Gaming" GroupName="ProfileGroup" Checked="ProfileRadio_Checked" />
                            <RadioButton x:Name="RadCustom" Content="Custom" GroupName="ProfileGroup" Checked="ProfileRadio_Checked" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource DarkSecondaryButtonStyle}" Click="ExportScripts_Click" Content="Export .ps1 / .reg" />
                            <Button x:Name="ApplyChangesButton" Style="{StaticResource ElectricAccentButtonStyle}" Click="PreviewSelected_Click" Content="Apply Changes..." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
