<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Strict Fluent 11 CornerRadius Scale:
         4px = Status Tags / Micro Badges (NEVER 999 — WinUI 3 renders 999 as distorted ovals!)
         6px = Buttons / Inputs / Segmented Items
         8px = Standard Cards & List Rows
        10px = Hero Containers & Dialogs -->

    <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="SubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="TerminalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentTerminalBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Crisp Enterprise Status Tag (CornerRadius 4 + 1px hairline border) -->
    <Style x:Key="StatusTagStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentTagBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Primary & Subtle Action Buttons -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtleActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource FluentSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- Segmented Profile ToggleButton -->
    <Style x:Key="ProfileSegmentToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
